#!/usr/bin/env bash
# Runs terraform with an access token from an explicit gcloud configuration,
# so a different account's Application Default Credentials are never used.
#
# Usage: GCLOUD_CONFIGURATION=<config> infra/tf plan
set -euo pipefail

: "${GCLOUD_CONFIGURATION:?set GCLOUD_CONFIGURATION to the gcloud configuration of the project owner}"
GOOGLE_OAUTH_ACCESS_TOKEN="$(gcloud auth print-access-token --configuration="$GCLOUD_CONFIGURATION")"
export GOOGLE_OAUTH_ACCESS_TOKEN

cd "$(dirname "$0")"
exec terraform "$@"
